{
  "name": "@tt/providers",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@mastra/core": "1.64.0",
    "@tt/ad-quality": "workspace:*",
    "@tt/core": "workspace:*",
    "@tt/domain": "workspace:*",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "mailparser": "3.9.38",
    "mammoth": "1.13.0",
    "nodemailer": "10.1.0",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "26.4.1",
    "@types/nodemailer": "8.0.2",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
