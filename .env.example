# ---------- Platform identity (nome del prodotto non deciso: si cambia solo qui) ----------
PLATFORM_NAME=team-tracker
PLATFORM_URL=http://localhost:3000
PLATFORM_SUPPORT_EMAIL=support@example.com
# it | en
PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_PLATFORM_NAME=team-tracker
NUXT_PUBLIC_PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_TIME_ZONE=Europe/Rome
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin of the Fastify api: the web app proxies /api/** here.
NUXT_API_INTERNAL_URL=http://localhost:4100
# Indirizzo del client usato dai limiti di frequenza. Il proxy web NON si fida mai di x-forwarded-for, x-real-ip né
# cf-connecting-ip inviati dal client: usa l'indirizzo della connessione. Se il sito sta dietro Cloudflare imposta
# true: allora cf-connecting-ip è considerato l'IP del client (accettalo solo se l'origine è raggiungibile solo da
# Cloudflare, altrimenti chiunque può falsificarlo). Dietro un altro reverse proxy tutti i client risultano con
# l'IP del proxy: vale un solo limite condiviso (più sicuro, meno preciso).
NUXT_TRUST_CLOUDFLARE=false

# ---------- Runtime ----------
NODE_ENV=development
RUN_MIGRATIONS=true
API_PORT=4100
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=
# Proxy di cui l'api crede x-forwarded-for: un numero di hop (es. 1) oppure indirizzi/CIDR separati da virgola
# (es. 172.18.0.0/16,10.0.0.5). Vuoto = solo loopback (127.0.0.1 e ::1), dove gira il proxy web in sviluppo.
# In docker compose metti la rete del container web. "true" non è ammesso: ogni client sceglierebbe il proprio IP
# e aggirerebbe tutti i limiti di frequenza.
TRUST_PROXY=
# Tetti giornalieri (24 ore) alle candidature della pagina pubblica, contate sulle candidature salvate:
# sopra il tetto il form risponde 429 con un messaggio gentile.
APPLICATIONS_DAILY_MAX_PER_ORGANIZATION=500
APPLICATIONS_DAILY_MAX_PER_JOB=200
# Worker: estrazioni di CV al giorno per organizzazione che possono chiamare il modello (FAST_MODEL).
# Oltre il budget si estrae solo il testo, senza modello.
CV_MODEL_DAILY_BUDGET=1000
LOG_LEVEL=info

# ---------- Database (docker compose default) ----------
DATABASE_URL=postgres://tt:tt@localhost:5434/team_tracker

# ---------- Auth (Better Auth) ----------
# The browser talks to the web origin, which proxies /api/* to the API: the auth base URL is the WEB origin.
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# ---------- Email (EmailProvider: smtp | resend | log) ----------
# In locale: SMTP verso Mailpit (docker compose, UI su http://localhost:8025). Con `log` nulla viene inviato.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Solo con EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Dominio di invio (per Resend viene registrato e verificato) e parte locale del mittente predefinito.
EMAIL_DOMAIN=localhost
EMAIL_FROM_LOCAL=noreply
# Dominio che riceve le risposte: gli indirizzi sono reply+<token>@<dominio>.
EMAIL_INBOUND_DOMAIN=inbound.localhost
# Segreto dei webhook in ingresso (Resend: whsec_...; generico: HMAC-SHA256 di "<timestamp>.<corpo>" in x-tt-signature, con il timestamp unix in secondi in x-tt-timestamp;
# si rifiuta un timestamp più vecchio di 5 minuti o più avanti di 1 minuto). Minimo 32 caratteri.
INBOUND_WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars

# ---------- Webhook in uscita ----------
# Solo sviluppo locale (api e worker rifiutano di avviarsi con true se NODE_ENV=production): true consente URL http://localhost e indirizzi privati come destinazione. In produzione resta false:
# il worker risolve l'host e rifiuta indirizzi privati, loopback, link-local e metadata; i redirect non vengono seguiti.
WEBHOOKS_ALLOW_PRIVATE=false

# ---------- Storage (S3 compatible: MinIO in locale e self-hosting) ----------
# Obbligatorio per api e worker: i CV dei candidati vivono qui. Il bucket viene creato all'avvio se manca.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=team-tracker
S3_ACCESS_KEY=tt-minio
S3_SECRET_KEY=tt-minio-secret
S3_FORCE_PATH_STYLE=true

# ---------- LLM: "provider/model" (Mastra model router). Mai un SDK di un fornitore importato direttamente. ----------
# Solo il nome del fornitore (prima della "/") compare nel registro dei trattamenti, mai il modello né le chiavi.
# Assistente interno (POST /api/v1/agent/chat): vuoto = assistente spento (GET /api/v1/agent/status dice enabled false,
# la chat risponde 503 agent_disabled). Serve anche la chiave API del fornitore. La memoria delle conversazioni (una per
# persona e organizzazione, cancellabile) vive nello schema Postgres `mastra` di DATABASE_URL.
# Eval avversariale col modello reale, sul database di test: pnpm --filter @tt/api eval:agent
AGENT_MODEL=
# Modello veloce per il punteggio di qualità dell'annuncio e per l'estrazione strutturata dei CV nel worker
# (es. openai/<modello>). Vuoto: il punteggio è calcolato solo con regole e dai CV si estrae solo il testo,
# senza chiamate a modelli. Se impostato, va impostata anche la chiave API del fornitore
# (OPENAI_API_KEY, ANTHROPIC_API_KEY o GOOGLE_GENERATIVE_AI_API_KEY).
FAST_MODEL=
# Soglia di segnalazione del punteggio (0-10): sotto soglia l'annuncio è segnalato, mai bloccato.
PLATFORM_AD_QUALITY_THRESHOLD=6

# ---------- Self-hosting (docker-compose.prod.yml) ----------
# `docker compose -f docker-compose.prod.yml up -d --build` legge questo file. Cambia SEMPRE i segreti qui sotto
# (BETTER_AUTH_SECRET, INBOUND_WEBHOOK_SECRET, S3_SECRET_KEY, POSTGRES_PASSWORD) e imposta PLATFORM_URL all'URL pubblico.
# Gli indirizzi dei servizi interni (database, MinIO, api) sono fissati nel compose: DATABASE_URL, S3_ENDPOINT e
# NUXT_API_INTERNAL_URL di questo file valgono solo per lo sviluppo locale.
POSTGRES_USER=tt
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=team_tracker
# Porta pubblicata dall'app web (l'unico servizio esposto). L'api e' raggiungibile solo da 127.0.0.1 su API_PUBLISH.
WEB_PORT=3000
API_PUBLISH=127.0.0.1:4000
# Email nel compose: TT_EMAIL_PROVIDER (log | smtp | resend, default log: nulla viene inviato) e TT_SMTP_HOST (default mailpit).
# Per la posta di sviluppo: TT_EMAIL_PROVIDER=smtp e `--profile mail` (UI Mailpit su MAILPIT_UI_PORT).
# Per SMTP reale: TT_EMAIL_PROVIDER=smtp, TT_SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_DOMAIN.
MAILPIT_UI_PORT=8025
# Rete interna del compose (di default 172.31.77.0/24, cambiala se confligge). Il compose la usa come TRUST_PROXY dell'api
# (il web e' il suo proxy): lascia TRUST_PROXY vuoto. WEBHOOKS_ALLOW_PRIVATE resta sempre false nel compose.
TT_SUBNET=172.31.77.0/24
