# Full variable reference (generated from the env schemas): docs/ENVIRONMENT.md

# ---------- Platform identity (the product name is not decided: change it only here) ----------
PLATFORM_NAME=team-tracker
PLATFORM_URL=http://localhost:3000
PLATFORM_SUPPORT_EMAIL=support@example.com
# it | en
PLATFORM_DEFAULT_LOCALE=it
# IANA time zone for dates in emails (the screens use NUXT_PUBLIC_TIME_ZONE)
PLATFORM_TIME_ZONE=Europe/Rome
NUXT_PUBLIC_PLATFORM_NAME=team-tracker
NUXT_PUBLIC_PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_TIME_ZONE=Europe/Rome
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Where repository files can be browsed (e.g. https://host/org/repo/blob/main). Empty: paths are shown as text.
NUXT_PUBLIC_SOURCE_URL=
# Origin of the Fastify api: the web app proxies /api/** here.
NUXT_API_INTERNAL_URL=http://localhost:4100
# Web proxy limits: largest request body streamed to the api (default 204 MiB, the api's biggest route limit) and
# milliseconds to wait for the api to start answering. Uncomment to change.
# NUXT_API_MAX_BODY_BYTES=213909504
# NUXT_API_TIMEOUT_MS=300000
# Client address used by the rate limits. The web proxy NEVER trusts x-forwarded-for, x-real-ip or cf-connecting-ip
# sent by the client: it uses the connection address. Behind Cloudflare set true: cf-connecting-ip is then taken as the
# client IP (only if the origin is reachable through Cloudflare alone, otherwise anyone can forge it). Behind another
# reverse proxy every client shows the proxy IP: one shared limit (safer, less precise).
NUXT_TRUST_CLOUDFLARE=false

# ---------- Runtime ----------
NODE_ENV=development
RUN_MIGRATIONS=true
API_PORT=4100
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=
# Requests per minute allowed to each API key (empty: the default of the api). Each MCP tool call of a batch counts as one.
API_KEY_RATE_LIMIT=
# Days a new API key lives when its creator gives no expiry (1-365). Every key expires, at most after a year.
API_KEY_DEFAULT_TTL_DAYS=90
# Daily budgets (UTC day) of paid model calls: MCP model-backed tools (analyze_job_ad, publish_job, only when FAST_MODEL
# is set) per API key, per person (across their keys and organizations) and per organization, and assistant chat
# requests per person and per organization.
MCP_MODEL_DAILY_BUDGET_PER_KEY=200
MCP_MODEL_DAILY_BUDGET_PER_USER=300
MCP_MODEL_DAILY_BUDGET_PER_ORGANIZATION=1000
ASSISTANT_DAILY_BUDGET_PER_USER=200
ASSISTANT_DAILY_BUDGET_PER_ORGANIZATION=2000
# Proxies whose x-forwarded-for the api believes: a hop count (e.g. 1) or comma-separated addresses/CIDRs
# (e.g. 172.18.0.0/16,10.0.0.5). Empty = loopback only (127.0.0.1 and ::1), where the web proxy runs in development.
# In docker compose use the network of the web container. "true" is not allowed: every client would pick its own IP
# and bypass all rate limits.
TRUST_PROXY=
# Daily caps (24 hours) on applications from the public page, counted on saved applications:
# above the cap the form answers 429 with a polite message.
APPLICATIONS_DAILY_MAX_PER_ORGANIZATION=500
APPLICATIONS_DAILY_MAX_PER_JOB=200
# Worker: CV extractions per organization and day that may call the model (FAST_MODEL).
# Above the budget only the text is extracted, without the model.
CV_MODEL_DAILY_BUDGET=1000
# Days after which an import never committed is purged
IMPORT_STALE_DAYS=7
LOG_LEVEL=info

# ---------- Database (docker compose default) ----------
DATABASE_URL=postgres://tt:tt@localhost:5434/team_tracker

# ---------- Auth (Better Auth) ----------
# The browser talks to the web origin, which proxies /api/* to the API: the auth base URL is the WEB origin.
# Production refuses to start with this example secret (or any short, low-entropy one) and with an http URL:
# generate the secret with `openssl rand -base64 48` and serve the app over https.
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
# open: anyone may create an account (default outside production; the e2e suite needs it). invite_only (default in
# production, docker-compose.prod.yml): only an address with a pending invitation, plus the very first account of the
# instance (its first owner). Empty = the default of NODE_ENV. Accounts always confirm their email before signing in.
SIGNUP_MODE=
# One-time secret for the first owner's sign-up in invite_only mode: open /signup?setup and type it in the "Setup
# token" field (sent as a header, never in a URL). Required in production to bootstrap the instance; at least 32 random
# characters (`openssl rand -base64 48`). Once the first owner has confirmed the email it opens nothing: remove it.
BOOTSTRAP_TOKEN=
# Who may create organizations (each one has its own model budgets): open, one_per_user (one organization ever created
# per account; the limit is per account, so invite-only sign-up is what bounds people) or instance_admins (only the
# first owner and INSTANCE_ADMIN_EMAILS). Empty = one_per_user when SIGNUP_MODE is invite_only, open otherwise.
ORGANIZATION_CREATION=
INSTANCE_ADMIN_EMAILS=

# ---------- Email (EmailProvider: smtp | resend | log) ----------
# Locally: SMTP to Mailpit (docker compose, UI on http://localhost:8025). With `log` nothing is sent, so nobody can
# confirm an address or reset a password: production refuses it.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Only with EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Sending domain (Resend registers and verifies it) and local part of the default sender.
EMAIL_DOMAIN=localhost
EMAIL_FROM_LOCAL=noreply
# Domain that receives replies: addresses are reply+<token>@<domain>.
EMAIL_INBOUND_DOMAIN=inbound.localhost
# Inbound webhook secret (Resend: whsec_...; generic: HMAC-SHA256 of "<timestamp>.<body>" in x-tt-signature, with the
# unix timestamp in seconds in x-tt-timestamp; a timestamp older than 5 minutes or more than 1 minute ahead is
# rejected). At least 32 characters.
INBOUND_WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars

# ---------- Outbound webhooks ----------
# Local development only (api and worker refuse to start with true when NODE_ENV=production): true allows http://localhost
# and private addresses as targets. In production keep it false: the worker resolves the host and rejects private,
# loopback, link-local and metadata addresses; redirects are not followed.
WEBHOOKS_ALLOW_PRIVATE=false

# ---------- Storage (S3 compatible: MinIO locally and when self-hosting) ----------
# Required by api and worker: candidates' CVs live here. The bucket is created at start when missing.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=team-tracker
S3_ACCESS_KEY=tt-minio
S3_SECRET_KEY=tt-minio-secret
S3_FORCE_PATH_STYLE=true

# ---------- LLM: "provider/model" (Mastra model router). Never import a vendor SDK directly. ----------
# Only the provider name (before the "/") appears in the processing register, never the model or the keys.
# Internal assistant (POST /api/v1/agent/chat): empty = assistant off (GET /api/v1/agent/status says enabled false,
# chat answers 503 agent_disabled). The provider's API key is needed too. The assistant is stateless: the conversation
# lives in the browser and the server stores nothing of it (docs/adr/0007-stateless-assistant.md).
# Adversarial eval with the real model, on the test database: pnpm --filter @tt/api eval:agent
AGENT_MODEL=
# Fast model for the ad quality score and for structured CV extraction in the worker (e.g. openai/<model>).
# Empty: the score is computed with rules only and only the text is extracted from CVs, with no model calls.
# When set, set the provider's API key too.
FAST_MODEL=
# Provider API keys (set the one of the provider used in AGENT_MODEL / FAST_MODEL).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Score threshold (0-10): below it the ad is flagged, never blocked.
PLATFORM_AD_QUALITY_THRESHOLD=6

# ---------- Self-hosting (docker-compose.prod.yml) ----------
# `docker compose -f docker-compose.prod.yml up -d --build` reads this file. ALWAYS change the secrets below
# (BETTER_AUTH_SECRET, INBOUND_WEBHOOK_SECRET, S3_SECRET_KEY, POSTGRES_PASSWORD: `openssl rand -base64 48`), set
# PLATFORM_URL to the public https URL and EMAIL_PROVIDER to smtp or resend: the stack refuses to start otherwise
# (docker/config-check.sh, then the api and the worker). SIGNUP_MODE defaults to invite_only there.
# Internal service addresses (database, MinIO, api) are fixed in the compose file: DATABASE_URL, S3_ENDPOINT and
# NUXT_API_INTERNAL_URL of this file only apply to local development.
POSTGRES_USER=tt
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=team_tracker
# Port published by the web app (the only exposed service). The api is reachable only from 127.0.0.1 on API_PUBLISH.
WEB_PORT=3000
# Address of the host the web port is bound to: 127.0.0.1 when a reverse proxy on the same host (Caddy, nginx, Dokploy's Traefik) is the only way in.
WEB_BIND=0.0.0.0
API_PUBLISH=127.0.0.1:4000
# Email in the compose file uses EMAIL_PROVIDER (smtp | resend, required) and SMTP_HOST
# (default mailpit). For development mail: EMAIL_PROVIDER=smtp and `--profile mail` (Mailpit UI on MAILPIT_UI_PORT).
# For real SMTP: EMAIL_PROVIDER=smtp, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, EMAIL_DOMAIN.
MAILPIT_UI_PORT=8025
# Internal compose network (default 172.31.77.0/24, change it if it clashes). The compose file uses it as the api's
# TRUST_PROXY (the web is its proxy): leave TRUST_PROXY empty. WEBHOOKS_ALLOW_PRIVATE is always false in the compose file.
TT_SUBNET=172.31.77.0/24
# Fixed address of the web container inside TT_SUBNET: the only address the api believes X-Forwarded-For from.
# Change it together with TT_SUBNET.
TT_WEB_IP=172.31.77.10

# Optional Cloudflare Turnstile check on the public application form (off when empty).
# Site key (public) goes to the web, secret key to the api; create both in the Cloudflare dashboard.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Application receipt emails per organization per day (the public form cannot be used to mail strangers in bulk).
RECEIPTS_DAILY_MAX_PER_ORGANIZATION=300

# Giorni dopo cui eventi e consegne webhook consegnati vengono eliminati dal job giornaliero.
DELIVERY_LOG_RETENTION_DAYS=30

# ---------- Observability (all optional: nothing is exposed and nothing is sent anywhere unless set; docs/OPERATIONS.md) ----------
# Bearer token (at least 16 characters, `openssl rand -base64 24`) that opens GET /metrics (Prometheus) on the api (API_PORT)
# and on the worker (WORKER_PORT). Unset: there is no /metrics endpoint. Never put /metrics on a public route.
METRICS_TOKEN=
# DSN of a Sentry-compatible collector (Sentry, GlitchTip, Bugsink) for server errors of the api, the worker (jobs that ran
# out of attempts) and the web app (NUXT_SENTRY_DSN). Reports carry the error type, a scrubbed message, code locations and a
# request id: never request bodies, headers, emails or candidate data. Unset: nothing is sent.
SENTRY_DSN=
NUXT_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Health port of the worker (/health, /ready, /metrics). Internal network only; 0 turns it off.
WORKER_PORT=4001
WORKER_HOST=0.0.0.0

# ---------- Backups (docker-compose.prod.yml, profile "backup"; docs/OPERATIONS.md) ----------
# `docker compose -f docker-compose.prod.yml --profile backup up -d`: pg_dump every day at BACKUP_AT (UTC), kept
# BACKUP_RETENTION_DAYS days in the `backups` volume and, with BACKUP_UPLOAD=true, uploaded to S3 under BACKUP_S3_PREFIX.
# By default the upload goes to the platform's own MinIO (same disk: set BACKUP_S3_* to another provider for a real offsite copy).
BACKUP_AT=02:30
BACKUP_RETENTION_DAYS=14
BACKUP_UPLOAD=true
# BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# BACKUP_S3_REGION=eu-central-1
# BACKUP_S3_BUCKET=my-offsite-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=backups/
# BACKUP_S3_PATH_STYLE=true
# Server-side encryption header of the upload: AES256 or aws:kms (MinIO needs a KMS configured first). Empty: none.
BACKUP_S3_SSE=
# Encrypts every dump with AES-256 before it leaves the container. Keep this passphrase OUTSIDE the backups: without it they cannot be restored.
BACKUP_ENCRYPTION_PASSPHRASE=
