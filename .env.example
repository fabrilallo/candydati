# ---------- Platform identity (nome del prodotto non deciso: si cambia solo qui) ----------
PLATFORM_NAME=team-tracker
PLATFORM_URL=http://localhost:3000
PLATFORM_SUPPORT_EMAIL=support@example.com
# it | en
PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_PLATFORM_NAME=team-tracker
NUXT_PUBLIC_PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin of the Fastify api: the web app proxies /api/** here.
NUXT_API_INTERNAL_URL=http://localhost:4000

# ---------- Runtime ----------
NODE_ENV=development
RUN_MIGRATIONS=true
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=
LOG_LEVEL=info

# ---------- Database (docker compose default) ----------
DATABASE_URL=postgres://tt:tt@localhost:5434/team_tracker

# ---------- Auth (Better Auth) ----------
# The browser talks to the web origin, which proxies /api/* to the API: the auth base URL is the WEB origin.
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# ---------- Email (EmailProvider: resend | smtp | log) ----------
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=
SMTP_URL=

# ---------- Storage (S3 compatible: MinIO in locale e self-hosting) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=team-tracker
S3_ACCESS_KEY=tt-minio
S3_SECRET_KEY=tt-minio-secret
S3_FORCE_PATH_STYLE=true

# ---------- LLM: "provider/model" (Mastra model router). Mai un SDK di un fornitore importato direttamente. ----------
AGENT_MODEL=
# Modello veloce per il punteggio di qualità dell'annuncio (es. openai/<modello>). Vuoto: il punteggio è calcolato
# solo con regole, senza chiamate a modelli. Se impostato, va impostata anche la chiave API del fornitore
# (OPENAI_API_KEY, ANTHROPIC_API_KEY o GOOGLE_GENERATIVE_AI_API_KEY).
FAST_MODEL=
# Soglia di segnalazione del punteggio (0-10): sotto soglia l'annuncio è segnalato, mai bloccato.
PLATFORM_AD_QUALITY_THRESHOLD=6
