# ---------- Platform identity (nome del prodotto non deciso: si cambia solo qui) ----------
PLATFORM_NAME=team-tracker
PLATFORM_URL=http://localhost:3000
PLATFORM_SUPPORT_EMAIL=support@example.com
# it | en
PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_PLATFORM_NAME=team-tracker
NUXT_PUBLIC_PLATFORM_DEFAULT_LOCALE=it
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin of the Fastify api: the web app proxies /api/** here.
NUXT_API_INTERNAL_URL=http://localhost:4100

# ---------- Runtime ----------
NODE_ENV=development
RUN_MIGRATIONS=true
API_PORT=4100
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=
LOG_LEVEL=info

# ---------- Database (docker compose default) ----------
DATABASE_URL=postgres://tt:tt@localhost:5434/team_tracker

# ---------- Auth (Better Auth) ----------
# The browser talks to the web origin, which proxies /api/* to the API: the auth base URL is the WEB origin.
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# ---------- Email (EmailProvider: smtp | resend | log) ----------
# In locale: SMTP verso Mailpit (docker compose, UI su http://localhost:8025). Con `log` nulla viene inviato.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Solo con EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Dominio di invio (per Resend viene registrato e verificato) e parte locale del mittente predefinito.
EMAIL_DOMAIN=localhost
EMAIL_FROM_LOCAL=noreply
# Dominio che riceve le risposte: gli indirizzi sono reply+<token>@<dominio>.
EMAIL_INBOUND_DOMAIN=inbound.localhost
# Segreto dei webhook in ingresso (Resend: whsec_...; generico: HMAC-SHA256 in x-tt-signature). Minimo 32 caratteri.
INBOUND_WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars

# ---------- Webhook in uscita ----------
# Solo sviluppo locale: true consente URL http://localhost e indirizzi privati come destinazione. In produzione resta false:
# il worker risolve l'host e rifiuta indirizzi privati, loopback, link-local e metadata; i redirect non vengono seguiti.
WEBHOOKS_ALLOW_PRIVATE=false

# ---------- Storage (S3 compatible: MinIO in locale e self-hosting) ----------
# Obbligatorio per api e worker: i CV dei candidati vivono qui. Il bucket viene creato all'avvio se manca.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=team-tracker
S3_ACCESS_KEY=tt-minio
S3_SECRET_KEY=tt-minio-secret
S3_FORCE_PATH_STYLE=true

# ---------- LLM: "provider/model" (Mastra model router). Mai un SDK di un fornitore importato direttamente. ----------
# Solo il nome del fornitore (prima della "/") compare nel registro dei trattamenti, mai il modello né le chiavi.
# Assistente interno (POST /api/v1/agent/chat): vuoto = assistente spento (GET /api/v1/agent/status dice enabled false,
# la chat risponde 503 agent_disabled). Serve anche la chiave API del fornitore. La memoria delle conversazioni (una per
# persona e organizzazione, cancellabile) vive nello schema Postgres `mastra` di DATABASE_URL.
# Eval avversariale col modello reale, sul database di test: pnpm --filter @tt/api eval:agent
AGENT_MODEL=
# Modello veloce per il punteggio di qualità dell'annuncio e per l'estrazione strutturata dei CV nel worker
# (es. openai/<modello>). Vuoto: il punteggio è calcolato solo con regole e dai CV si estrae solo il testo,
# senza chiamate a modelli. Se impostato, va impostata anche la chiave API del fornitore
# (OPENAI_API_KEY, ANTHROPIC_API_KEY o GOOGLE_GENERATIVE_AI_API_KEY).
FAST_MODEL=
# Soglia di segnalazione del punteggio (0-10): sotto soglia l'annuncio è segnalato, mai bloccato.
PLATFORM_AD_QUALITY_THRESHOLD=6
