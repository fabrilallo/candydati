{
  "name": "@candydati/worker",
  "version": "0.1.9",
  "private": true,
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@candydati/core": "workspace:*",
    "@candydati/db": "workspace:*",
    "@candydati/domain": "workspace:*",
    "@candydati/providers": "workspace:*",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
