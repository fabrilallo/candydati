{
  "name": "@candydati/api",
  "version": "0.8.0",
  "private": true,
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint .",
    "eval:agent": "tsx --env-file=../../.env eval/agent-eval.ts"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@candydati/ad-quality": "workspace:*",
    "@candydati/core": "workspace:*",
    "@candydati/db": "workspace:*",
    "@candydati/domain": "workspace:*",
    "@candydati/providers": "workspace:*",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/sensible": "6.0.7",
    "@mastra/ai-sdk": "1.11.3",
    "@mastra/core": "1.82.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.163",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "fflate": "0.8.3",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
