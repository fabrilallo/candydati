{
  "name": "@candydati/api",
  "version": "0.1.14",
  "private": true,
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint .",
    "eval:agent": "tsx --env-file=../../.env eval/agent-eval.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.5",
    "@mastra/ai-sdk": "1.10.1",
    "@mastra/core": "1.64.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@candydati/ad-quality": "workspace:*",
    "@candydati/core": "workspace:*",
    "@candydati/db": "workspace:*",
    "@candydati/domain": "workspace:*",
    "@candydati/providers": "workspace:*",
    "ai": "7.0.92",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.0",
    "fflate": "0.8.3",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
